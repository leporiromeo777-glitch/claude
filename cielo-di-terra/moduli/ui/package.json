{
  "name": "@cielo-di-terra/ui",
  "private": true,
  "version": "0.1.0",
  "description": "Interfaccia di «Cielo di Terra»: titolo, pausa, impostazioni, dialoghi, carte, taccuino, Pianta del Verbano, indicazioni a schermo, crediti e caricamento (TypeScript + DOM/CSS, senza framework)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/im-fell-english-sc": "5.3.0",
    "@fontsource/playwrite-it-moderna": "5.3.0",
    "@fontsource/special-elite": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "happy-dom": "21.0.1",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.4"
  }
}
