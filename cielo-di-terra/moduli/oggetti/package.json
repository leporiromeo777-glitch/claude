{
  "name": "@cielo-di-terra/oggetti",
  "private": true,
  "version": "0.1.0",
  "description": "Cielo di Terra: libreria di oggetti 3D procedurali (rustici, campanile, castagni, muri a secco, capisaldi, abitanti velati, Fade, lumi)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
