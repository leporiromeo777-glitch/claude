    "misure": "node scripts/schermate.mjs --solo-misure"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.4"
  }
}
