<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TRAMA: manifest della privacy (ARCHITETTURA 13, GDD 15).
  Nessun tracciamento, nessun dominio di tracciamento, nessun dato raccolto.
  API "con motivo dichiarato" usate dall'app:
  - UserDefaults (salvataggi e impostazioni tramite @capacitor/preferences):
    motivo CA92.1, dati letti e scritti solo dall'app stessa;
  - marcatura temporale dei file: @capacitor/filesystem contiene le chiamate che
    leggono data di creazione e di modifica dei file (Apple le rileva nel binario).
    L'app usa il plugin solo per l'immagine da condividere, scritta nella cache:
    motivo C617.1, solo file dentro il contenitore dell'app.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
