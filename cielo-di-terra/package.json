{
  "name": "cielo-di-terra",
  "private": true,
  "version": "0.1.0",
  "description": "Cielo di Terra: open world in prima persona dentro un cilindro di O'Neill (fase 1A, kernel del cilindro)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.4"
  }
}
