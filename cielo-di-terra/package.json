{
  "name": "cielo-di-terra",
  "private": true,
  "version": "0.1.0",
  "description": "Cielo di Terra: open world in prima persona dentro un cilindro di O'Neill (fase 1: prologo e missione 1)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/shots.mjs",
    "shots:indicazioni": "node scripts/shots-indicazioni.mjs",
    "verifica-contenuti": "tsx src/narrativa/scripts/verifica-contenuti.ts",
    "e2e:fase1": "node scripts/e2e-fase1.mjs"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/im-fell-english-sc": "5.3.0",
    "@fontsource/patrick-hand-sc": "5.3.0",
    "@fontsource/playwrite-it-moderna": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.4",
    "happy-dom": "21.0.1",
    "tsx": "4.23.15"
  }
}
